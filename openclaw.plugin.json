{
  "id": "doc-engine",
  "name": "Semantic Documentation Engine",
  "description": "Multi-repo semantic documentation retrieval with TF-IDF embeddings, incremental indexing, and priority-based conflict resolution",
  "version": "1.0.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "repositories": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "path", "priority", "type"],
          "properties": {
            "name": { "type": "string" },
            "path": { "type": "string" },
            "priority": { "type": "number", "minimum": 1 },
            "type": { "type": "string", "enum": ["core", "extension"] },
            "glob": { "type": "string" }
          }
        }
      },
      "storage": { "type": "string" },
      "chunkMaxTokens": { "type": "number", "default": 800 },
      "topK": { "type": "number", "default": 5 },
      "watchEnabled": { "type": "boolean", "default": true },
      "watchDebounceMs": { "type": "number", "default": 2000 },
      "secretPatterns": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  },
  "uiHints": {
    "repositories": { "label": "Documentation Repositories", "help": "List of repos to index" },
    "storage": { "label": "Storage Path", "help": "Directory for index data" },
    "watchEnabled": { "label": "Watch for Changes", "help": "Auto-reindex on file changes" },
    "secretPatterns": { "label": "Secret Patterns", "help": "Regex patterns to redact before indexing", "advanced": true }
  }
}
