{
  "name": "@openclaw/doc-engine",
  "version": "1.0.0",
  "description": "Multi-repo semantic documentation engine for OpenClaw",
  "type": "module",
  "openclaw": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "vitest": "^3.0.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
